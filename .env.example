# ==============================================================================
# ATLAS Monorepo Environment Configuration Template
# Copy this file to .env for local overrides. Never commit .env to source control.
# ==============================================================================

# Global Environment (local, test, staging, production)
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# Service Ports & Hosts (127.0.0.1 for local isolation)
API_GATEWAY_HOST=127.0.0.1
API_GATEWAY_PORT=8000

RESEARCH_ORCHESTRATOR_HOST=127.0.0.1
RESEARCH_ORCHESTRATOR_PORT=8001

INGESTION_SERVICE_HOST=127.0.0.1
INGESTION_SERVICE_PORT=8002

RETRIEVAL_SERVICE_HOST=127.0.0.1
RETRIEVAL_SERVICE_PORT=8003

AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8004

EVALUATION_SERVICE_HOST=127.0.0.1
EVALUATION_SERVICE_PORT=8005

GEMINI_API_KEY=
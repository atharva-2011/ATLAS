# ==============================================================================
# ATLAS: Multi-Agent Research Intelligence System
# Comprehensive Environment Configuration Template (.env.example)
# Copy this file to .env for local overrides. Never commit .env to source control.
# ==============================================================================

# --- Global Environment Settings ---
ENVIRONMENT=local                  # local | test | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                 # console | json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Microservice Network Bindings (Host & Port) ---
API_GATEWAY_HOST=127.0.0.1
API_GATEWAY_PORT=8000

RESEARCH_ORCHESTRATOR_HOST=127.0.0.1
RESEARCH_ORCHESTRATOR_PORT=8001

INGESTION_SERVICE_HOST=127.0.0.1
INGESTION_SERVICE_PORT=8002

RETRIEVAL_SERVICE_HOST=127.0.0.1
RETRIEVAL_SERVICE_PORT=8003

AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=8004

EVALUATION_SERVICE_HOST=127.0.0.1
EVALUATION_SERVICE_PORT=8005

# --- Microservice Inter-Service URLs ---
RESEARCH_ORCHESTRATOR_URL=http://127.0.0.1:8001
INGESTION_SERVICE_URL=http://127.0.0.1:8002
RETRIEVAL_SERVICE_URL=http://127.0.0.1:8003
AGENT_RUNTIME_URL=http://127.0.0.1:8004
EVALUATION_SERVICE_URL=http://127.0.0.1:8005

# --- Relational Database (PostgreSQL / SQLite) ---
# For local development SQLite can be used: sqlite+aiosqlite:///./atlas_orchestrator.db
# For production PostgreSQL:
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_secure_password_replace_in_prod
POSTGRES_DB=atlas_research
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://atlas:atlas_secure_password_replace_in_prod@127.0.0.1:5432/atlas_research
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Distributed Cache & Queue (Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# --- Vector Database (Qdrant) ---
# Local in-memory: :memory: or remote: http://127.0.0.1:6333
QDRANT_LOCATION=:memory:
QDRANT_API_KEY=
QDRANT_PORT=6333
QDRANT_COLLECTION=atlas_evidence_chunks
EMBEDDING_PROVIDER=deterministic   # deterministic | sentence-transformers | openai
EMBEDDING_MODEL=deterministic-local-384
VECTOR_DIMENSION=384

# --- Object Storage & Ingestion (MinIO / S3) ---
MINIO_ROOT_USER=atlas_minio_admin
MINIO_ROOT_PASSWORD=atlas_minio_secret_replace_in_prod
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=atlas-research-docs
STORAGE_DIR=.atlas_storage/documents
MAX_UPLOAD_SIZE_BYTES=26214400      # 25 MB
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150

# --- LLM Providers & Keys (Agent Runtime) ---
DEFAULT_PROVIDER=mock              # mock | openai | anthropic | gemini
DEFAULT_MODEL=atlas-mock-v1
FALLBACK_PROVIDER=mock
FALLBACK_MODEL=atlas-mock-fallback
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# Commercial Provider API Keys (leave blank for local mock mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Security & Access Control ---
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_PER_MINUTE=120

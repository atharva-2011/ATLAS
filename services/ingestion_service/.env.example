# ==============================================================================
# Ingestion Service Configuration
# ==============================================================================
SERVICE_NAME=ingestion-service
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
HOST=127.0.0.1
PORT=8002
LOG_LEVEL=INFO
LOG_FORMAT=console
API_PREFIX=/api/v1

# Ingestion Storage & Chunking
STORAGE_DIR=.atlas_storage/documents
MAX_UPLOAD_SIZE_BYTES=26214400
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=150
MIN_SCANNED_CHARS_PER_PAGE=20

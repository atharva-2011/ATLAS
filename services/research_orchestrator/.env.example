# ==============================================================================
# Research Orchestrator Service Configuration
# ==============================================================================
SERVICE_NAME=research-orchestrator
SERVICE_VERSION=0.1.0
ENVIRONMENT=local
HOST=127.0.0.1
PORT=8001
LOG_LEVEL=INFO
LOG_FORMAT=console
API_PREFIX=/api/v1

# Database Configuration (SQLite default for quick local runs, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./atlas_orchestrator.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/atlas_orchestrator
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
